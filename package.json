{
  "name": "staycut-portal-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local portal/dev-server.mjs",
    "start": "node --env-file-if-exists=.env.local portal/dev-server.mjs --host 0.0.0.0",
    "test": "node --test --test-isolation=none portal/tests/*.test.mjs",
    "test:server": "node --test --test-isolation=none server-tests/*.test.mjs",
    "test:browser": "python3 portal/tests/browser.py",
    "test:auth-browser": "python3 portal/tests/auth-browser.py",
    "build": "node portal/scripts/build.mjs"
  }
}
